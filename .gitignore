# The warehouse and every cached response rebuild from `python scripts/ingest.py`.
# Nothing under data/ is committed — nflverse redistribution carries CC-BY 4.0
# attribution obligations, and a checked-in duckdb file is a merge conflict
# waiting to happen.
data/

.env

# Scratch scripts an agent writes for a single board run (ranking-synthesizer
# names them `_<what>_<date>`). They are working notes for one run, not project
# code: committing them would grow the repo every board, and linting them fails
# a clean tree on code nobody wrote by hand.
scripts/_*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environments
.venv/
venv/

# macOS
.DS_Store
